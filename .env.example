# ==========================================
# 1. DISCORD BOT CONFIG (BẮT BUỘC)
# ==========================================
# Token lấy từ Discord Developer Portal (Mục Bot -> Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here

# (Khuyên dùng) ID của Server Discord của bạn để Slash Commands cập nhật ngay lập tức trong 1 giây!
# Cách lấy: Bật Developer Mode trong Cài đặt Discord -> Chuột phải vào tên Server -> Copy Server ID
GUILD_ID=

# ==========================================
# 2. AI CONFIG (TÙY CHỌN CHO TÍNH NĂNG AI)
# ==========================================
# Google Gemini API Key (Lấy miễn phí tại: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Nếu bạn muốn dùng mô hình GPT)
OPENAI_API_KEY=

# ==========================================
# 3. MÁY CHỦ & KEEP-ALIVE
# ==========================================
# Cổng chạy Web Server nhẹ (Render sẽ tự động cấp biến này)
PORT=3000
