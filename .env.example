# Token từ Discord Developer Portal (mục Bot -> Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here

# API Key từ OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# (Khuyên dùng) ID của Server của bạn để Slash Commands (/ask, /reset) cập nhật ngay lập tức!
# Cách lấy: Bật Developer Mode trên Discord -> Chuột phải vào tên Server -> Copy Server ID
GUILD_ID=

# (Tùy chọn) ID của kênh chat chỉ định nếu bạn muốn bot chỉ trả lời ở kênh đó
# Để trống nếu muốn bot trả lời khi được tag ở bất kỳ kênh nào
ALLOWED_CHANNEL_ID=
